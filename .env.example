# Optional public backend URL for a separately hosted or future Capacitor frontend.
# Leave unset for same-origin Docker hosting and Vite's development proxy.
# VITE_API_BASE_URL=https://your-backend.example

# Backend-only settings (never use a VITE_ prefix for secrets).
# OTP_URL=http://127.0.0.1:8080/otp/gtfs/v1
# PORT=3001
# HOST=127.0.0.1
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,https://localhost
