<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card: the app icon's dark purple, in the app's "knife" shape (three corners
     slightly rounded, the bottom-right one clearly). Newer Androids may round it their own way. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#2e2440" />
    <corners
        android:topLeftRadius="6dp"
        android:topRightRadius="6dp"
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="26dp" />
</shape>
