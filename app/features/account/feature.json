{
  "name": "Account",
  "description": "Your account page: sign in with Google, or with an email and password.",
  "version": "1.5.0",
  "main": "Account.js",
  "styles": ["account.css"],
  "native": {
    "packages": { "@capacitor-firebase/authentication": "^7.5.0" },
    "capacitor": {
      "plugins": {
        "FirebaseAuthentication": { "skipNativeAuth": true, "providers": ["google.com"] }
      }
    },
    "android": {
      "files": { "app/google-services.json": "native/google-services.json" },
      "gradle": { "rgcfaIncludeGoogle": true }
    },
    "ios": {
      "files": { "GoogleService-Info.plist": "native/GoogleService-Info.plist" },
      "plist": {
        "CFBundleURLTypes": [
          { "CFBundleURLSchemes": ["com.googleusercontent.apps.116399300931-q596uj8ttmh7nm43ll60evrrm523e6n0"] }
        ]
      },
      "pods": ["pod 'CapacitorFirebaseAuthentication/Google', :path => '../../node_modules/@capacitor-firebase/authentication'"]
    }
  }
}
