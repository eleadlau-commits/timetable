rules_version = '2';

// Mobile Durham's database rules. Anything not allowed below is refused.
// To publish: Firebase console → Firestore Database → Rules → paste this whole file → Publish.
// The tests in tests/ check these rules, and GitHub runs them before every release.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is asking ----

    // Signed in with Google, or with an email and password once the email address has been
    // confirmed (the link Firebase emails after Create account). That stops made-up addresses
    // from using backup and friends.
    function signedIn() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider == 'google.com'
          || (request.auth.token.firebase.sign_in_provider == 'password'
            && request.auth.token.email_verified == true));
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Your private area: only you can read or change it ----
    //   main     your timetable link (if you back it up)
    //   profile  your name for friends, your friend code, and the people you've asked or
    //            accepted (at most 50), which limits how many requests and friends you can have

    match /users/{uid}/private/{doc} {
      allow read, delete: if isMe(uid) && doc in ['main', 'profile'];
      allow create, update: if isMe(uid)
        && ((doc == 'main' && validMain(request.resource.data))
          || (doc == 'profile' && validProfile(uid, request.resource.data)));
    }

    function validMain(d) {
      return d.keys().hasOnly(['link', 'updatedAt'])
        && d.keys().hasAll(['updatedAt'])
        && d.updatedAt == request.time
        && (!('link' in d) || validLink(d.link));
    }

    function validLink(link) {
      return link is string && link.size() <= 2048 && link.matches('(https|webcal)://[^\\s]+');
    }

    function validProfile(uid, d) {
      return d.keys().hasOnly(['name', 'code', 'people', 'updatedAt'])
        && d.keys().hasAll(['name', 'code', 'people', 'updatedAt'])
        && validName(d.name)
        && validCode(d.code)
        && d.people is list && d.people.size() <= 50 && !(uid in d.people)
        && d.updatedAt == request.time;
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 30;
    }

    // Friend codes look like MD-7K3Q-9P2X: letters and digits that can't be confused.
    function validCode(code) {
      return code is string && code.matches('MD-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}');
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/private/profile).data;
    }

    function profileAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/private/profile).data;
    }

    // ---- Friend codes: look up who a code belongs to ----
    // Anyone signed in can look up one code they've been given, but nobody can list codes.
    // A code can only be made by its owner, and must be the one in their profile.

    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validCode(code)
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name)
        && profileAfter(request.auth.uid).code == code;
      allow update: if isMe(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
      allow delete: if isMe(resource.data.uid);
    }

    // ---- Friendships: one document per pair of people, named "<uid>_<uid>" (smaller first) ----
    //   pending   "from" asked "to". "to" can already see from's timetable.
    //   accepted  both can see each other's.
    // Only "from" can create it, only "to" can accept it, either can rename themselves in it,
    // and either can delete it (cancel, decline or remove).

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function friendship(a, b) {
      return /databases/$(database)/documents/friendships/$(pairId(a, b));
    }

    match /friendships/{pair} {
      // You can look at a pair you're part of (even before it exists), and list your own.
      allow get: if signedIn() && request.auth.uid in pair.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.users;

      allow create: if signedIn() && validRequest(pair, request.resource.data);

      // Accepting: only "to", only from pending, and only the status, time and their own name change.
      allow update: if signedIn() && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'names'])
        && onlyMyName(request.resource.data, resource.data)
        // Counts against your limit of 50 people.
        && resource.data.from in profileAfter(request.auth.uid).people;

      // Renaming yourself: only your own name changes.
      allow update: if signedIn() && request.auth.uid in resource.data.users
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
        && onlyMyName(request.resource.data, resource.data);

      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    function validRequest(pair, d) {
      let me = request.auth.uid;
      return d.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'code', 'createdAt'])
        && d.from == me
        && d.to is string && d.to != me
        && pair == pairId(me, d.to)
        && d.users == (me < d.to ? [me, d.to] : [d.to, me])
        && d.status == 'pending'
        && d.createdAt == request.time
        // You need their code: it must be a real code belonging to them.
        && validCode(d.code)
        && get(/databases/$(database)/documents/codes/$(d.code)).data.uid == d.to
        // Names: yours and theirs, as shown to each of you.
        && d.names.keys().hasOnly([me, d.to]) && d.names.keys().hasAll([me, d.to])
        && validName(d.names[me]) && validName(d.names[d.to])
        // Counts against your limit of 50 people.
        && d.to in profileAfter(me).people;
    }

    function onlyMyName(after, before) {
      return after.names.diff(before.names).affectedKeys().hasOnly([request.auth.uid])
        && validName(after.names[request.auth.uid]);
    }

    // ---- Shared timetables: your classes for the next 4 weeks ----
    // You can write your own. Someone else can read it only if you've asked them (pending, from
    // you) or you're friends (accepted).

    match /shared/{uid} {
      allow read: if isMe(uid) || (signedIn() && canSee(request.auth.uid, uid));
      allow create, update: if isMe(uid) && validShared(request.resource.data);
      allow delete: if isMe(uid);
    }

    function canSee(viewer, owner) {
      let path = friendship(viewer, owner);
      return exists(path)
        && (get(path).data.status == 'accepted' || get(path).data.from == owner);
    }

    function validShared(d) {
      return d.keys().hasOnly(['classes', 'updatedAt'])
        && d.classes is list && d.classes.size() <= 400
        && d.updatedAt == request.time;
    }

    // ---- Places on Spots: cafés, pubs and clubs, with their student deals ----
    // Everyone can read the published ones, signed in or not (they're public, like a poster).
    // Unpublished places are drafts. The team adds places in the Firebase console (which isn't
    // bound by these rules), and the people in 'admins' can change them from the app (Approve
    // changes). A shop's owner can read their own place, even as a draft, but never change it
    // directly: they send a change (spotChanges) that waits for approval.
    // The app asks for at most 100 at once; asking for more, or for all of them, is refused,
    // which keeps each look small on the free plan's daily reads.

    match /spots/{place} {
      allow get: if resource.data.published == true || isAdmin() || ownsPlace(place);
      allow list: if (resource.data.published == true && request.query.limit <= 100)
        || (isAdmin() && request.query.limit <= 200);
      allow create: if isAdmin() && validPlace(request.resource.data);
      // Approving a change: places typed in the console may spell things their own way, so
      // only the card's parts are checked.
      allow update: if isAdmin() && validCard(request.resource.data);
      allow delete: if isAdmin();
    }

    function validPlace(d) {
      return d.keys().hasAll(['published', 'kind', 'name'])
        && d.published is bool
        && d.kind in ['cafe', 'pub', 'club']
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && validCard(d);
    }

    // ---- The team: who may approve changes ----
    // admins/{uid} is made by hand in the Firebase console. Each person can only check
    // whether they themselves are one.

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if isMe(uid);
    }

    // ---- Shops: which account looks after which place ----

    function ownerPath(uid) {
      return /databases/$(database)/documents/shopOwners/$(uid);
    }

    function ownsPlace(place) {
      return signedIn() && exists(ownerPath(request.auth.uid))
        && get(ownerPath(request.auth.uid)).data.place == place;
    }

    // Shop codes: the team makes one for a place and hands it to the owner. Anyone signed in can
    // look up one code they've been given (they can't be listed or guessed), and use it once:
    // marking it used by their own account. The person who used it can delete it (Delete my
    // account does).

    function validShopCode(code) {
      return code.matches('[A-HJ-NP-Z2-9]{8}');
    }

    match /shopCodes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin() && request.query.limit <= 200;
      allow create: if isAdmin() && validShopCode(code)
        && request.resource.data.keys().hasOnly(['place', 'usedBy', 'made'])
        && request.resource.data.place is string
        && request.resource.data.usedBy == null
        && request.resource.data.made == request.time;
      allow update: if signedIn() && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.usedBy == request.auth.uid);
    }

    // shopOwners/{uid}: the place an account looks after. You make your own with a code that
    // you've used (in the same step), or the team makes it when they approve a request.

    match /shopOwners/{uid} {
      allow get: if isMe(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if validOwner(request.resource.data)
        && (isAdmin()
          || (isMe(uid) && validShopCode(request.resource.data.code)
            && getAfter(/databases/$(database)/documents/shopCodes/$(request.resource.data.code)).data.usedBy == uid
            && getAfter(/databases/$(database)/documents/shopCodes/$(request.resource.data.code)).data.place == request.resource.data.place));
      allow update: if isAdmin() && validOwner(request.resource.data);
      allow delete: if isMe(uid) || isAdmin();
    }

    function validOwner(d) {
      return d.keys().hasOnly(['place', 'code', 'at']) && d.keys().hasAll(['place', 'code'])
        && d.place is string && d.code is string;
    }

    // The parts of a card an owner can change, all optional: short texts, https links, and
    // the deal's last day.
    function optionalText(d, key, most) {
      return !(key in d) || (d[key] is string && d[key].size() <= most);
    }

    function optionalLink(d, key) {
      return !(key in d) || d[key] == ''
        || (d[key] is string && d[key].size() <= 500 && d[key].matches('https://[^\\s]+'));
    }

    // Opening times, day by day (see app/features/spots/hours.js): seven parts, Monday first,
    // '0800-1700' or nothing for closed, e.g. '0800-1700|0800-1700|0800-1700|0800-1700|0800-1700|0900-1700|'.
    function optionalOpen(d) {
      return !('open' in d) || d.open == ''
        || (d.open is string && d.open.matches('(([0-9]{4}-[0-9]{4})?[|]){6}([0-9]{4}-[0-9]{4})?'));
    }

    function validCard(d) {
      return optionalText(d, 'line', 120) && optionalText(d, 'deal', 120) && optionalText(d, 'hours', 120)
        && optionalOpen(d) && optionalText(d, 'photo', 500)
        && optionalText(d, 'address', 120)
        && optionalLink(d, 'link') && optionalLink(d, 'menu')
        && (!('dealEnds' in d) || d.dealEnds == null || d.dealEnds is timestamp)
        && (!('order' in d) || d.order is number);
    }

    // spotChanges/{place}: an owner's change to their card, waiting for approval. The owner can
    // send, resend or withdraw it; only the team can approve or reject it (just the status).

    match /spotChanges/{place} {
      allow get: if isAdmin() || ownsPlace(place);
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create, update: if ownsPlace(place) && validChange(place, request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin() || ownsPlace(place);
    }

    function validChange(place, d) {
      return d.keys().hasOnly(['place', 'by', 'line', 'deal', 'dealEnds', 'hours', 'open', 'link', 'menu', 'status', 'at'])
        && d.keys().hasAll(['place', 'by', 'status', 'at'])
        && d.place == place && d.by == request.auth.uid
        && d.status == 'waiting' && d.at == request.time
        && validCard(d);
    }

    // spotRequests/{uid}: a business without a code asking to be listed. Only they and the team
    // can see it; the team approves or rejects it (just the status).

    match /spotRequests/{uid} {
      allow get: if isMe(uid) || isAdmin();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create, update: if isMe(uid) && validListingRequest(uid, request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isMe(uid) || isAdmin();
    }

    function validListingRequest(uid, d) {
      return d.keys().hasOnly(['by', 'kind', 'name', 'address', 'contact', 'line', 'deal', 'dealEnds', 'hours', 'open', 'link', 'menu', 'status', 'at'])
        && d.keys().hasAll(['by', 'kind', 'name', 'contact', 'status', 'at'])
        && d.by == uid
        && d.kind in ['cafe', 'pub', 'club']
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.contact is string && d.contact.size() >= 1 && d.contact.size() <= 120
        && d.status == 'waiting' && d.at == request.time
        && validCard(d);
    }

    // spotStats/{place}_{week}: how many phones saw a place's card that week (seen), and tapped
    // its Website or Menu (taps). Anyone can add one, signed in or not, and nothing else: no
    // names, no account numbers. Only the place's owner and the team can read them.

    match /spotStats/{stat} {
      allow get: if isAdmin() || ownsPlace(stat.split('_')[0]);
      allow create: if validStat(stat, request.resource.data)
        && request.resource.data.get('seen', 0) in [0, 1]
        && request.resource.data.get('taps', 0) in [0, 1]
        && exists(/databases/$(database)/documents/spots/$(request.resource.data.place));
      allow update: if validStat(stat, request.resource.data)
        && request.resource.data.place == resource.data.place
        && request.resource.data.week == resource.data.week
        && (request.resource.data.get('seen', 0) - resource.data.get('seen', 0)) in [0, 1]
        && (request.resource.data.get('taps', 0) - resource.data.get('taps', 0)) in [0, 1];
    }

    function validStat(stat, d) {
      return d.keys().hasOnly(['place', 'week', 'seen', 'taps'])
        && d.keys().hasAll(['place', 'week'])
        && d.place is string && d.week is string && d.week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && stat == d.place + '_' + d.week
        && d.get('seen', 0) is int && d.get('taps', 0) is int;
    }
  }
}
