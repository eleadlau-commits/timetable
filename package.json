{
  "name": "durham-campus-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:iphone": "node scripts/dev-iphone.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "vite",
    "stop": "node scripts/stop-dev.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test --config playwright.card.config.ts",
    "test:card": "playwright test --config playwright.card.config.ts",
    "test:local": "node scripts/check-local.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "leaflet": "1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bwip-js": "^4.11.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
